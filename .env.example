# Copy to .env (gitignored) and adjust. Real environment variables override these.

# Runtime data: recordings, models, tunes, outputs, pipelines.
WHISTLE_HOUSE_DATA=./data

# External datasets (MLEnd, MUSAN, ESC-50, DEMAND). Large (~40 GB with everything, ~25 GB after
# `datasets fetch --clean-raw`). Set this on the training machine only - leave it unset on the Pi.
# WHISTLE_HOUSE_EXTERNAL=/mnt/datasets/whistle-house

# Parallel downloads for datasets made of many small files (MLEnd).
# WHISTLE_HOUSE_DOWNLOAD_WORKERS=8
